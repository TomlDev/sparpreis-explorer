# Supply-Chain: Install-Skripte nur fuer die in package.json (allowScripts) freigegebenen Pakete. Neues Paket mit Skript = Installation bricht ab.
# Pruefen: npm install-scripts ls | Freigeben: npm install-scripts approve <paket> | Ausnahme: --dangerously-allow-all-scripts
strict-allow-scripts=true
