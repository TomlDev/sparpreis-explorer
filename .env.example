# ---- App auth (single-user login) ----
# Both MUST be set — left empty, nobody can log in (fail closed).
# The password required on the login page (use a long random one).
APP_PASSWORD=
# Optional username stored in the session (informational only).
APP_USERNAME=user
# Secret used to sign the session cookie (min. 32 chars).
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Optional: own key for encrypting personal data (address, IBAN). If unset it is
# derived from AUTH_SECRET — then changing AUTH_SECRET makes that data unreadable.
# DATA_KEY=

# ---- Database ----
DATABASE_PATH=./data/bahn-finder.db

# ---- Routing (timetables) ----
# motis | mock — MOTIS/Transitous for connections + the learned route graph.
ROUTING_PROVIDER=motis
MOTIS_BASE=https://api.transitous.org

# ---- Pricing (DB) ----
# direct | gateway | dbrest | mock | off
#   direct  -> DB mobile/web API via db-vendo-client + TLS impersonation (curl_cffi)
#   gateway -> a residential gateway (apps/db-gateway), set DB_VENDO_GATEWAY_URL
#   dbrest  -> any db-rest v6 instance, set DB_REST_BASE
#   mock    -> offline deterministic demo data (no network)
DB_VENDO_MODE=direct
# Python with curl_cffi for "direct" (python3 -m venv .venv && .venv/bin/pip install curl_cffi)
DB_IMPERSONATE_PYTHON=./.venv/bin/python3
# DB_VENDO_GATEWAY_URL=http://127.0.0.1:3009
# Base URL for the dbrest provider.
DB_REST_BASE=https://v6.db.transport.rest
# User-Agent sent to DB endpoints (be a good citizen, include contact info).
RAIL_USER_AGENT=bahn-finder (contact: you@example.org)

# ---- Punctuality data (Einstellungen → Pünktlichkeit) ----
# Python with duckdb (defaults to DB_IMPERSONATE_PYTHON): .venv/bin/pip install duckdb
# DELAY_PYTHON=./.venv/bin/python3

# ---- Runtime ----
NODE_ENV=production
PORT=3005
TZ=Europe/Berlin
